  "derived_at_zarr_stage": {
    "rh2m": {
      "source": "urma",
      "inputs": [
        "t2m",
        "dpt2m"
      ],
      "method": "relative_humidity_from_temperature_and_dewpoint",
      "units": "percent",
      "note": "Derived from URMA T and Td (K); choose saturation convention explicitly at Zarr conversion."
    },
    "snowc": {
      "source": "rap_surface",
      "inputs": [
        "snod"
      ],
      "method": "binary_snow_presence_from_depth",
      "threshold_m": 0.01,
      "units": "binary 0/1",
      "note": "Provisional snow-presence proxy, not fractional snow-cover percentage. Preserve this distinction in plot labels."
    },
    "rh2m_rtma": {
      "source": "rtma",
      "inputs": [
        "t2m",
        "dpt2m"
      ],
      "method": "relative_humidity_from_temperature_and_dewpoint",
      "units": "percent",
      "note": "Derived from URMA T and Td (K); choose saturation convention explicitly at Zarr conversion."
    }
